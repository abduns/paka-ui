# -----------------------------------------------------------------------------
# Starter Kit environment template
# -----------------------------------------------------------------------------
#
# Copy this file to .env (`cp .env.example .env`) and treat .env as a secret.
# Never commit populated values. After changing production settings, rebuild
# cached configuration and restart Horizon so workers load the new values:
#
#   php artisan optimize:clear
#   php artisan optimize
#   php artisan horizon:terminate
#
# Values below are local-development defaults. They are not suitable for a
# public installation without review. See also:
#
#   docs/installation.md
#   docs/configuration.md
#   docs/production.md
#

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Display name used in mail, cache/session/Horizon key prefixes, and the
# Vite-built UI (via VITE_APP_NAME below).
APP_NAME="Starter Kit"

# Runtime environment. Horizon supervisor settings switch on this value
# (local vs production). Use "production" on public deployments.
APP_ENV=local

# Encrypts cookies, sessions, and other signed data. Generated by
# `php artisan key:generate` during setup. Back it up; losing it invalidates
# every signed link and session cookie already issued.
APP_KEY=

# Comma-separated former APP_KEY values kept as decryption fallbacks while
# rotating the current key. Leave empty unless you are mid-rotation.
APP_PREVIOUS_KEYS=

# Detailed exception output with stack traces. Always false in production.
APP_DEBUG=true

# Canonical public origin. Signed password-reset and email-verification links
# are bound to this value, so changing it invalidates links already sent. The
# host is also the WebAuthn passkey relying-party ID; a change locks people
# out of passkey sign-in unless PASSKEYS_USER_HANDLE_SECRET was set
# independently. Use the public HTTPS origin in production.
APP_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Access and proxies
# -----------------------------------------------------------------------------

# Comma-separated proxy addresses (or CIDR) whose X-Forwarded-* headers
# should be trusted for the client IP. Leave empty when the app is served
# directly. Use explicit addresses behind a load balancer or CDN. Never set
# "*" on a server that is reachable without a proxy — clients can then spoof
# their IP and collapse rate limiting.
TRUSTED_PROXIES=

# When true, strangers may create an account. When false, public registration
# is closed but invited teammates can still finish sign-up. Prefer false in
# production unless open registration is intentional. The installer writes
# this value; changing it does not require a frontend rebuild.
REGISTRATION_ENABLED=true

# Secret used to derive WebAuthn user handles. Set it explicitly in
# production so rotating APP_KEY does not invalidate passkeys. Left empty,
# it defaults to APP_KEY.
PASSKEYS_USER_HANDLE_SECRET=

# -----------------------------------------------------------------------------
# Locale
# -----------------------------------------------------------------------------

# Default application locale for translations.
APP_LOCALE=en

# Locale used when a translation is missing for APP_LOCALE.
APP_FALLBACK_LOCALE=en

# Faker locale for factories and seed data (not user-facing).
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# Maintenance and hashing
# -----------------------------------------------------------------------------

# How maintenance mode is stored. "file" is fine for a single server; "cache"
# coordinates it across multiple machines.
APP_MAINTENANCE_DRIVER=file

# bcrypt cost factor. 12 is the Laravel default. Tests override this to 4 in
# phpunit.xml so the suite stays fast. Do not lower this in production.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Default log channel. "stack" writes to the channels listed in LOG_STACK.
LOG_CHANNEL=stack

# Comma-separated channel names used by the stack driver (e.g. single, daily).
LOG_STACK=single

# Channel for PHP and library deprecation warnings. "null" discards them.
LOG_DEPRECATIONS_CHANNEL=null

# Minimum log level: debug, info, notice, warning, error, critical, alert,
# emergency. Use "debug" locally and "info" or "warning" in production.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
#
# SQLite is the local default. Create the file before migrating:
#   touch database/database.sqlite
#
# For MySQL, MariaDB, or PostgreSQL, set DB_CONNECTION and uncomment the
# connection details. PostgreSQL uses port 5432. Use a managed, backed-up
# database in production.

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=starter_kit
# DB_USERNAME=root
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------

# Session storage. "database" uses the sessions table.
# Supported: file, cookie, database, memcached, redis, dynamodb, array.
SESSION_DRIVER=database

# Idle lifetime in minutes before the session expires.
SESSION_LIFETIME=120

# Encrypt session payloads in the store. Cookie contents are already
# encrypted by Laravel; enable this if the session store is shared.
SESSION_ENCRYPT=false

# Cookie path. Leave as / unless the app is served from a subdirectory.
SESSION_PATH=/

# Cookie domain. "null" scopes the cookie to the current host. Set to the
# parent domain only if the session must be shared across subdomains.
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Files, queues, and cache
# -----------------------------------------------------------------------------

# Default filesystem disk. "local" stores workspace logos and other uploads
# under storage/app/public, symlinked to public/storage by `storage:link`
# (run automatically during app:install). Include that directory in backups.
# The kit does not ship a cloud disk; add a Flysystem driver if you need one.
FILESYSTEM_DISK=local

# Queue backend. Horizon requires redis. Password-reset, verification, and
# workspace-invitation mail are queued on the default queue — a web server
# alone will not send them. Keep `php artisan horizon` running.
QUEUE_CONNECTION=redis

# Seconds a Redis-queued job may run before it is released for retry. Must
# stay greater than Horizon's supervisor timeout (60s in config/horizon.php).
REDIS_QUEUE_RETRY_AFTER=90

# Cache store. Redis is the kit default; start Redis before installation.
# Supported: array, database, file, memcached, redis, dynamodb, octane.
CACHE_STORE=redis

# Used only when CACHE_STORE=memcached.
MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
#
# Required for the default cache and queue. Horizon does not support Redis
# Cluster. Authenticate Redis and restrict network access in production.

# Client: phpredis (extension, recommended) or predis (Composer package).
REDIS_CLIENT=phpredis

REDIS_HOST=127.0.0.1

# "null" means no password. Set a real password in production.
REDIS_PASSWORD=null

REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
#
# One application-wide mailer is used for account verification, password
# resets, and workspace invitations. There is no per-workspace mail config.
#
# The local default is an SMTP catcher on 127.0.0.1:2525. That is not a
# production relay. Use MAIL_MAILER=log to write messages to the application
# log instead. Production needs a real transport whose MAIL_FROM_ADDRESS is
# authorized by the provider.

# Transport: smtp, sendmail, mailgun, ses, ses-v2, postmark, resend, log, array.
MAIL_MAILER=smtp

# SMTP scheme. Leave "null" for STARTTLS (typically port 587). Use "smtps"
# with port 465 only when the provider requires implicit TLS.
MAIL_SCHEME=null

MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Envelope sender. Must be authorized by the relay in production.
MAIL_FROM_ADDRESS="hello@example.com"

# From name. ${APP_NAME} is expanded from APP_NAME above.
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Horizon
# -----------------------------------------------------------------------------
#
# Horizon processes the Redis-backed default queue. Keep it alive through
# the host's process manager (`php artisan horizon`) and run the scheduler
# every minute so `horizon:snapshot` fills the metrics dashboard and expired
# workspace invitations are pruned.
#
# The local supervisor caps at 3 processes (config/horizon.php). The values
# below apply to the production supervisor.

# Maximum worker processes for the production default supervisor.
HORIZON_DEFAULT_MAX_PROCESSES=6

# Seconds the redis:default queue may wait before Horizon fires a
# LongWaitDetected alert (emailed to HORIZON_NOTIFICATION_EMAIL).
HORIZON_DEFAULT_WAIT_SECONDS=60

# How many job/queue metric snapshots to retain. Combined with a snapshot
# every minute, 288 covers about 24 hours.
HORIZON_METRICS_SNAPSHOTS=288

# Comma-separated accounts allowed to open /horizon outside local
# development. Leave empty and the dashboard is closed to everyone in
# production. Example: admin@example.com,ops@example.com
HORIZON_ALLOWED_EMAILS=

# Recipient for Horizon long-wait (and related) mail notifications.
# Leave empty to disable mail alerts.
HORIZON_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------

# Exposed to the Vite-built UI as import.meta.env.VITE_APP_NAME.
VITE_APP_NAME="${APP_NAME}"

# Hugeicons style aliased at build time. The public default is the free
# package. Pro styles require your own Hugeicons license and are never
# installed or distributed by this repository.
# Supported: free-stroke-rounded, pro-stroke-rounded, pro-stroke-standard,
#            pro-solid-rounded, pro-solid-standard
HUGEICONS_ICON_STYLE=free-stroke-rounded
